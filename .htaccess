RewriteEngine On

# Force non-www (www.toonmela.com was serving identical content as a
# separate 200 OK instead of redirecting - canonical tags pointed the
# right way, but an explicit redirect is more robust and saves crawl
# budget instead of relying on canonical hints alone).
RewriteCond %{HTTP_HOST} ^www\.toonmela\.com$ [NC]
RewriteRule ^(.*)$ https://toonmela.com/$1 [R=301,L]

# 301 Redirects - Old WordPress URLs to new site
# Old story URLs -> homepage
RewriteRule ^sachai-aur-imaandari-ki-jeet/?$ https://toonmela.com/ [R=301,L]
RewriteRule ^chalak-lomdi/?$ https://toonmela.com/ [R=301,L]
RewriteRule ^chudel-ki-chudiyan/?$ https://toonmela.com/ [R=301,L]

# Old WordPress feed URLs -> new RSS feed
RewriteRule ^(.+)/feed/?$ https://toonmela.com/feed.xml [R=301,L]
RewriteRule ^feed/?$ https://toonmela.com/feed.xml [R=301,L]

# Old WordPress tag/category/author pages -> stories page
RewriteRule ^tag/(.+)/?$ https://toonmela.com/stories.php [R=301,L]
RewriteRule ^category/(.+)/?$ https://toonmela.com/stories.php [R=301,L]
RewriteRule ^author/(.+)/?$ https://toonmela.com/about.php [R=301,L]

# Old WordPress page URLs (clean URLs without .php) -> homepage
RewriteRule ^page/([0-9]+)/?$ https://toonmela.com/ [R=301,L]

# Remove .php extension
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.*)$ $1.php [L]

# Custom 404
ErrorDocument 404 /404.php

# Serve sitemap.xml and feed.xml via PHP
RewriteRule ^sitemap\.xml$ sitemap.php [L]
RewriteRule ^feed\.xml$ feed.php [L]

# Security headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# Block access to sensitive data files
<FilesMatch "^(stories|clicks|reviews)\.json$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>
<FilesMatch "\.md$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>

# Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript text/xml application/xml
</IfModule>

# Cache static assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>
